{# ./templates/partials/_header.html.twig #}

{% import 'components/macros/_Icon.macro.html.twig' as Icon %}
{% import 'components/macros/_Button.macro.html.twig' as Button %}

{% set headerNavItems = [
    { label: 'home', routeName: 'home_index' },
    { label: 'categories', routeName: '#' },
    { label: 'trends', routeName: '#' },
    { label: 'about', routeName: '#' }
] %}

<header class="header">
    <div class="header__inner">
        <div class="header__logo">
            {{ Icon.lucide(config('framework.app.icon'), {
                color: 'accent',
                background: true,
                spacing: true,
                size: 'sm'
            }) }}
            <span class="header__title">
                {{ config('framework.app.name') }}
            </span>
        </div>
        <nav class="header__nav">

            {% for item in headerNavItems %}

                {{ Button.render(translate('header.nav.links.' ~ item.label, domain: 'header'), {
                    href: item.routeName != '#' ? path(item.routeName) : '#',
                    variant: app.current_route == item.routeName or app.current_route starts with item.routeName ? 'primary' : 'ghost',
                    size: 'sm'
                }) }}

            {% endfor %}

        </nav>
        <div class="header__actions">

            {{ Button.render(translate('header.nav.actions.login', domain: 'header'), {
                href: '#',
                variant: 'primary-outline',
                size: 'sm'
            }) }}

            {{ Button.render(translate('header.nav.actions.register', domain: 'header'), {
                href: '#',
                variant: 'primary',
                size: 'sm'
            }) }}

            {{ Button.render(null, {
                iconLeft: 'cog',
                variant: 'ghost-outline',
                size: 'sm',
                iconOptions: { size: 'sm' },
                attributes: {
                    'data-modal-open': 'settings'
                }
            }) }}

        </div>
    </div>
</header>

{% embed 'components/embeds/_Modal.embed.html.twig' with {
    modalName: 'settings',
    modalTitle: 'Settings'
} %}
    {% block modalContent %}

        <div class="">
            {% for theme in config('framework.app.design_themes')|json_decode %}
                <button data-theme-change="{{ theme }}">{{ theme }}</button>
            {% endfor %}
        </div>

        <div class="">
            {% for accent in config('framework.app.design_accents')|json_decode %}
                <button data-accent-change="{{ accent }}">{{ accent }}</button>
            {% endfor %}
        </div>

        <div class="">
            {% for scale in config('framework.app.design_scales')|json_decode %}
                <button data-scale-change="{{ scale }}">{{ scale }}</button>
            {% endfor %}
        </div>

        <div class="">
            {% for locale in locales() %}
                <button data-locale-change="{{ locale }}">{{ locale }}</button>
            {% endfor %}
        </div>

        <script type="text/javascript">

            window.initPreferenceChange('theme', '{{ path("preference_api_change_theme") }}', 'data-theme');
            window.initPreferenceChange('accent', '{{ path("preference_api_change_accent") }}', 'data-accent');
            window.initPreferenceChange('scale', '{{ path("preference_api_change_scale") }}', 'data-scale');
            window.initPreferenceChange('locale', '{{ path("preference_api_change_locale") }}', 'data-locale', true);

        </script>

    {% endblock %}
{% endembed %}
