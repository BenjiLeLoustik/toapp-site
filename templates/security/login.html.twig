{# ./templates/pages/security/login.html.twig #}

{% extends 'layouts/base_layout.html.twig' %}

{% import 'components/macros/_Form.macro.html.twig' as Form %}

{% block content %}

    <section class="login screen screen--margin screen--full">

        <div class="login__container">

            <header class="login__header">
                <h1 class="login__title">
                    Sign in
                </h1>
                <p class="login__description">
                    Enter your email and password to access your account.
                </p>
            </header>

            {% if error %}
                <p class="login__error">
                    {{ error }}
                </p>
            {% endif %}

            {{ form_start(form, { attr: { class: 'login__form' } }) }}

                {{ Form.input('_username', {
                    id: 'username',
                    label: 'Email',
                    value: last_username,
                    type: 'email',
                    autocomplete: 'username',
                    required: true,
                    attributes: {
                        autofocus: true
                    }
                }) }}

                {{ Form.input('_password', {
                    id: 'password',
                    label: 'Password',
                    type: 'password',
                    autocomplete: 'current-password',
                    required: true
                }) }}

                {{ Form.checkbox('_remember_me', {
                    id: 'remember_me',
                    label: 'Remember me'
                }) }}

                {{ Form.submit('Sign in') }}

            {{ form_end(form) }}

        </div>

    </section>

{% endblock %}