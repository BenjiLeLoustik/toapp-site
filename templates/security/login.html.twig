{# ./templates/pages/security/login.html.twig #}

{% extends 'layouts/base_layout.html.twig' %}

{% import 'components/macros/_Form.macro.html.twig' as Form %}

{% block content %}

    {% set errorMessage = error ? error ~ '' : null %}

    <section class="login screen screen--margin screen--full">

        <div class="login__container">

            <header class="login__header">
                <h1 class="login__title">
                    {{ translate('login.title') }}
                </h1>
                <p class="login__description">
                    {{ translate('login.description') }}
                </p>
            </header>

            {{ form_start(form, { attr: { class: 'login__form', novalidate: 'novalidate' } }) }}

                {{ Form.input('_username', {
                    id: 'username',
                    label: translate('login.fields.email'),
                    value: last_username,
                    type: 'email',
                    iconLeft: 'mail',
                    autocomplete: 'username',
                    required: true,
                    class: errorMessage ? 'form__field--invalid' : '',
                    attributes: {
                        autofocus: true
                    }
                }) }}

                {{ Form.input('_password', {
                    id: 'password',
                    label: translate('login.fields.password'),
                    type: 'password',
                    iconLeft: 'lock',
                    autocomplete: 'current-password',
                    required: true,
                    error: errorMessage
                }) }}

                {{ Form.checkbox('_remember_me', {
                    id: 'remember_me',
                    label: translate('login.fields.remember_me')
                }) }}

                {{ Form.submit(translate('login.submit'), {
                    class: 'login__submit'
                }) }}

                {{ form_widget(form['_csrf_token']) }}

            {{ form_end(form, { render_rest: false }) }}

            <p class="login__footer">
                {{ translate('login.no_account') }}
                <a href="{{ path('app_security_register') }}" class="login__link">
                    {{ translate('login.register') }}
                </a>
            </p>

        </div>

    </section>

{% endblock %}