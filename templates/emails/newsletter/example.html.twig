{# ./templates/emails/newsletter/example.html.twig #}

{% extends 'emails/_layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;color:#111827;">{{ title }}</h1>

    <p style="margin:0 0 12px;font-size:15px;line-height:1.6;">{{ translate('emails.newsletter.greeting', { name: name }) }}</p>

    <p style="margin:0 0 12px;font-size:15px;line-height:1.6;">
        Write the content of the newsletter here.
    </p>
{% endblock %}