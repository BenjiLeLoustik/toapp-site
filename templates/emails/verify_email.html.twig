{# ./templates/emails/verify_email.html.twig #}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ translate('emails.verify.subject', { app: app }) }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f5f7;padding:32px 16px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background-color:#ffffff;border:1px solid #e5e7eb;border-radius:12px;">
                <tr>
                    <td style="padding:32px;">
                        <p style="margin:0 0 24px;font-size:18px;font-weight:bold;color:#2563eb;">{{ app }}</p>

                        <h1 style="margin:0 0 16px;font-size:22px;color:#111827;">
                            {{ translate('emails.verify.title') }}
                        </h1>

                        <p style="margin:0 0 12px;font-size:15px;line-height:1.6;">
                            {{ translate('emails.verify.greeting', { name: name }) }}
                        </p>

                        <p style="margin:0 0 24px;font-size:15px;line-height:1.6;">
                            {{ translate('emails.verify.body', { app: app }) }}
                        </p>

                        <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
                            <tr>
                                <td style="border-radius:8px;background-color:#2563eb;">
                                    <a href="{{ url }}" style="display:inline-block;padding:12px 24px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;">
                                        {{ translate('emails.verify.button') }}
                                    </a>
                                </td>
                            </tr>
                        </table>

                        <p style="margin:0 0 8px;font-size:13px;line-height:1.6;color:#6b7280;">
                            {{ translate('emails.verify.fallback') }}
                        </p>

                        <p style="margin:0 0 24px;font-size:13px;line-height:1.6;word-break:break-all;">
                            <a href="{{ url }}" style="color:#2563eb;">{{ url }}</a>
                        </p>

                        <p style="margin:0;font-size:13px;line-height:1.6;color:#6b7280;">
                            {{ translate('emails.verify.expires', { hours: hours }) }}<br>
                            {{ translate('emails.verify.ignore') }}
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>