{# ./templates/pages/settings/notifications.html.twig #}

{% extends 'pages/settings/_layout.html.twig' %}

{% import 'components/macros/_Form.macro.html.twig' as Form %}
{% import 'components/macros/_Button.macro.html.twig' as Button %}

{% block settings_title %}{{ translate('settings.notifications.title') }}{% endblock %}
{% block settings_description %}{{ translate('settings.notifications.description') }}{% endblock %}

{% block settings_content %}

    {% set frequencyOptions = {} %}
    {% for item in frequencies %}
        {% set frequencyOptions = frequencyOptions|merge({ (item.value): translate('settings.notifications.frequencies.' ~ item.value) }) %}
    {% endfor %}

    <form method="post" action="{{ path('settings_notifications') }}" class="settings__form">

        <input type="hidden" name="_token" value="{{ csrf_token('settings_notifications') }}">

        <div class="settings__section">
            <h2 class="settings__section-title">{{ translate('settings.notifications.email') }}</h2>

            {{ Form.switch('email_project_likes', {
                label: translate('settings.notifications.fields.project_likes.label'),
                description: translate('settings.notifications.fields.project_likes.description'),
                checked: notifications.emailProjectLikes
            }) }}

            {{ Form.switch('email_project_favorites', {
                label: translate('settings.notifications.fields.project_favorites.label'),
                description: translate('settings.notifications.fields.project_favorites.description'),
                checked: notifications.emailProjectFavorites
            }) }}

            {{ Form.switch('email_newsletter', {
                label: translate('settings.notifications.fields.newsletter.label'),
                description: translate('settings.notifications.fields.newsletter.description'),
                checked: notifications.emailNewsletter
            }) }}
        </div>

        <div class="settings__section">
            <h2 class="settings__section-title">{{ translate('settings.notifications.digest') }}</h2>

            <div class="form__switch-row">
                <div class="form__switch-text">
                    <span class="form__switch-label">{{ translate('settings.notifications.fields.digest.label') }}</span>
                    <span class="form__switch-description">{{ translate('settings.notifications.fields.digest.description') }}</span>
                </div>

                {{ Form.select('digest_frequency', {
                    value: notifications.digestFrequency.value,
                    options: frequencyOptions,
                    class: 'settings__inline-select'
                }) }}
            </div>
        </div>

        <div class="settings__actions">
            {{ Button.render(translate('settings.actions.save'), {
                type: 'submit',
                size: 'sm'
            }) }}
        </div>

    </form>

{% endblock %}