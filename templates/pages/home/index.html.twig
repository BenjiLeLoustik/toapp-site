{# ./templates/pages/home/index.html.twig #}

{% extends 'layouts/base_layout.html.twig' %}

{% import 'components/macros/_Button.macro.html.twig' as Button %}
{% import 'components/macros/_Form.macro.html.twig' as Form %}

{% block content %}

    <section class="hero screen screen--full screen--no-margin">

        <h1 class="hero__title">
            Find your <span class="hero__title--colored">next project</span>
        </h1>

        <p class="hero__sub-title">
            Explore millions of web projects, mobile apps, APIs, and much more.
            Join a community of passionate developers.
        </p>

        <div class="hero__search-bar">
            {{ Form.group([
                Form.input('search', {
                    iconLeft: 'search',
                    iconSize: 'sm',
                    placeholder: 'Search project, technology, framework...',
                    columns: 6
                }),
                Form.select('category', {
                    value: 'all',
                    options: {
                        'all': 'All categories'
                    },
                    columns: 4
                }),
                Form.submit('Search', {
                    columns: 2
                })
            ], { columns: 12, gap: 'xs' }) }}
        </div>

        <div class="hero__actions">

            {{ Button.render('Explore projects', {
                href: '#',
                variant: 'primary'
            }) }}

            {{ Button.render('Publish project', {
                href: '#',
                variant: 'ghost-outline'
            }) }}

        </div>

    </section>

    <section class="stats screen screen--no-margin">
        <div class="stat__block">
            <span class="stat__icon">
                <i data-lucide="folder"></i>
            </span>
            <span class="stat__value">
                +12.000
            </span>
            <span class="stat__title">
                Published projects
            </span>
        </div>
        <div class="stat__block">
            <span class="stat__icon">
                <i data-lucide="users-round"></i>
            </span>
            <span class="stat__value">
                +45.000
            </span>
            <span class="stat__title">
                Active developers
            </span>
        </div>
        <div class="stat__block">
            <span class="stat__icon">
                <i data-lucide="cpu"></i>
            </span>
            <span class="stat__value">
                +200
            </span>
            <span class="stat__title">
                Listed technologies
            </span>
        </div>
        <div class="stat__block">
            <span class="stat__icon">
                <i data-lucide="rocket"></i>
            </span>
            <span class="stat__value">
                98%
            </span>
            <span class="stat__title">
                User satisfaction
            </span>
        </div>
    </section>

    <section class="popular-projects screen screen--margin">
        [POPULAR PROJECTS SECTION]
    </section>

{% endblock %}