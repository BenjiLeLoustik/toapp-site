{# ./templates/pages/category/show.html.twig #}

{% extends 'layouts/base_layout.html.twig' %}

{% import 'components/macros/_Button.macro.html.twig' as Button %}
{% import 'components/macros/_Form.macro.html.twig' as Form %}
{% import 'components/macros/_Empty.macro.html.twig' as Empty %}
{% import 'components/macros/_Card.macro.html.twig' as Card %}
{% import 'components/macros/_Icon.macro.html.twig' as Icon %}
{% import 'components/macros/_Pagination.macro.html.twig' as Pagination %}

{% block content %}

    {% set translation = category.translation(locale()) %}
    {% set categoryName = translation.name ?? category.slug %}
    {% set resetUrl = path('category_show', { slug: category.slug }) %}

    {% set categoryOptions = {} %}
    {% for item in categories %}
        {% set categoryOptions = categoryOptions|merge({
            (item.slug): item.translation(locale()).name ?? item.slug
        }) %}
    {% endfor %}

    {% set sortOptions = {} %}
    {% for sort in sorts %}
        {% set sortOptions = sortOptions|merge({
            (sort.value): translate('category.show.sorts.' ~ sort.value)
        }) %}
    {% endfor %}

    {% set dateOptions = {} %}
    {% for date in dates %}
        {% set dateOptions = dateOptions|merge({
            (date.value): translate('category.show.dates.' ~ date.value)
        }) %}
    {% endfor %}

    <section class="category screen screen--margin">

        <nav class="category__breadcrumb" aria-label="Breadcrumb">
            <a href="{{ path('home_index') }}">{{ translate('category.show.breadcrumb.home') }}</a>
            {{ Icon.lucide('chevron-right', { size: 'xs', color: 'muted' }) }}
            <a href="{{ path('category_index') }}">{{ translate('category.show.breadcrumb.categories') }}</a>
            {{ Icon.lucide('chevron-right', { size: 'xs', color: 'muted' }) }}
            <span aria-current="page">{{ categoryName }}</span>
        </nav>

        <header class="category__header">
            <h1 class="category__title">
                {{ filters.hasSearch ? translate('category.show.title_search') : categoryName }}
            </h1>

            <p class="category__description">
                {% if filters.hasSearch %}
                    {{ translate('category.show.results_search', {
                        count: projects.total,
                        counterFormatted: projects.total|format_number,
                        search: filters.search,
                        category: categoryName
                    }) }}
                {% else %}
                    {{ translate('category.show.results', {
                        count: projects.total,
                        counterFormatted: projects.total|format_number,
                        category: categoryName
                    }) }}
                {% endif %}
            </p>
        </header>

        <form class="category__layout" method="get" action="{{ resetUrl }}" data-auto-submit>

            <aside class="category__filters">

                <header class="category__filters-header">
                    <span class="category__filters-title">
                        {{ translate('category.show.filters.title') }}
                    </span>

                    <a href="{{ resetUrl }}" class="category__filters-reset">
                        {{ translate('category.show.filters.reset') }}
                    </a>
                </header>

                <div class="category__filter">
                    <span class="category__filter-title">
                        {{ translate('category.show.filters.category') }}
                    </span>

                    {{ Form.select('category', {
                        id: 'filter-category',
                        value: category.slug,
                        options: categoryOptions
                    }) }}
                </div>

                {% if technologies is not empty %}
                    <div class="category__filter">
                        <span class="category__filter-title">
                            {{ translate('category.show.filters.technologies') }}
                        </span>

                        <div class="category__filter-list">
                            {% for technology in technologies %}
                                {{ Form.checkbox('technologies[]', {
                                    id: 'filter-technology-' ~ technology.slug,
                                    label: technology.name,
                                    value: technology.slug,
                                    checked: filters.hasTechnology(technology.slug)
                                }) }}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <div class="category__filter">
                    <span class="category__filter-title">
                        {{ translate('category.show.filters.sort') }}
                    </span>

                    <div class="category__filter-list">
                        {% for value, label in sortOptions %}
                            {{ Form.radio('sort', {
                                id: 'filter-sort-' ~ value,
                                value: value,
                                label: label,
                                checked: filters.sort.value == value
                            }) }}
                        {% endfor %}
                    </div>
                </div>

                <div class="category__filter">
                    <span class="category__filter-title">
                        {{ translate('category.show.filters.date') }}
                    </span>

                    {{ Form.select('date', {
                        id: 'filter-date',
                        value: filters.date.value,
                        options: dateOptions
                    }) }}
                </div>

            </aside>

            <div class="category__results">

                <div class="category__toolbar">

                    {{ Form.input('search', {
                        id: 'filter-search',
                        value: filters.search,
                        iconLeft: 'search',
                        iconSize: 'sm',
                        placeholder: translate('category.show.search_placeholder'),
                        class: 'category__search'
                    }) }}

                    <div class="category__toolbar-sort">
                        <label for="filter-sort-toolbar" class="category__toolbar-label">
                            {{ translate('category.show.filters.sort_by') }}
                        </label>

                        {{ Form.select('sort', {
                            id: 'filter-sort-toolbar',
                            value: filters.sort.value,
                            options: sortOptions,
                            attributes: { 'data-sort-sync': '' }
                        }) }}
                    </div>

                </div>

                {% if projects.total > 0 %}

                    {{ Card.projects(projects, { class: 'cards--projects-2' }) }}

                    {{ Pagination.render(projects, {
                        previousLabel: translate('pagination.previous'),
                        nextLabel: translate('pagination.next')
                    }) }}

                {% else %}

                    <div class="category__empty">
                        {{ Empty.render('search-x', translate('category.show.empty.title'), [
                            translate('category.show.empty.description_line_1'),
                            translate('category.show.empty.description_line_2')
                        ], [
                            Button.render(translate('category.show.empty.explore_categories'), {
                                href: path('category_index'),
                                variant: 'ghost-outline',
                                size: 'sm'
                            }),
                            Button.render(translate('category.show.empty.reset'), {
                                href: resetUrl,
                                variant: 'primary',
                                size: 'sm'
                            })
                        ]) }}
                    </div>

                {% endif %}

            </div>

        </form>

    </section>

{% endblock %}