{# ./templates/components/macros/_Button.macro.html.twig #}

{#
Usage :

    {% import 'components/macros/_Button.macro.html.twig' as Button %}

    Button.render('Créer');

    Button.render('Suivant', {
        variant: 'primary',
        iconRight: 'arrow-right',
        iconSize: 'sm'
    });

    Button.render(null, {
        iconLeft: 'trash',
        iconOptions: { color: 'accent', size: 'lg' }
    });
#}

{% macro render(label, options = {}) %}

    {% set href = options.href ?? null %}
    {% set variant = options.variant ?? 'primary' %}
    {% set size = options.size ?? 'base' %}
    {% set align = options.align ?? 'center' %}

    {% set iconLeft = options.iconLeft ?? null %}
    {% set iconRight = options.iconRight ?? null %}

    {% set iconSize = options.iconSize ?? null %}
    {% set iconOptions = options.iconOptions ?? {} %}

    {% set type = options.type ?? 'button' %}
    {% set disabled = options.disabled ?? false %}

    {% set class = options.class ?? '' %}
    {% set attributes = (options.attributes ?? {})|merge({
        'data-variant': variant
    }) %}

    {% set iconOnly = options.iconOnly ?? (not label and (iconLeft or iconRight)) %}

    {% set classes = [
        'button',
        'button--' ~ variant,
        'button--' ~ size,
        'button--align-' ~ align,
        iconOnly ? 'button--icon-only' : null,
        disabled ? 'button--disabled' : null,
        class
    ]|filter(v => v)|join(' ') %}

    {% if href %}
        <a
            href="{{ href }}"
            class="{{ classes }}"
            {% if disabled %}aria-disabled="true" tabindex="-1"{% endif %}
            {% for name, value in attributes %}
                {{ name }}="{{ value }}"
            {% endfor %}
        >
            {% if iconLeft %}
                {{ _self.render_icon(iconLeft, size, iconSize, iconOptions) }}
            {% endif %}

            {% if label %}
                <span class="button__label">
                    {{ label|raw }}
                </span>
            {% endif %}

            {% if iconRight %}
                {{ _self.render_icon(iconRight, size, iconSize, iconOptions) }}
            {% endif %}
        </a>
    {% else %}
        <button
            type="{{ type }}"
            class="{{ classes }}"
            {% if disabled %}disabled{% endif %}
            {% for name, value in attributes %}
                {{ name }}="{{ value }}"
            {% endfor %}
        >
            {% if iconLeft %}
                {{ _self.render_icon(iconLeft, size, iconSize, iconOptions) }}
            {% endif %}

            {% if label %}
                <span class="button__label">
                    {{ label|raw }}
                </span>
            {% endif %}

            {% if iconRight %}
                {{ _self.render_icon(iconRight, size, iconSize, iconOptions) }}
            {% endif %}
        </button>
    {% endif %}

{% endmacro %}

{% macro render_icon(name, buttonSize, customIconSize, extraOptions) %}
    {% import 'components/macros/_Icon.macro.html.twig' as Icon %}

    {% set finalSize = customIconSize ?? extraOptions.size ?? buttonSize %}

    {% set iconConfig = extraOptions|merge({
        size: finalSize
    }) %}

    {{ Icon.lucide(name, iconConfig) }}
{% endmacro %}