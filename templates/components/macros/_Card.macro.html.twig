{# ./templates/components/macros/_Card.macro.html.twig #}

{#
    Usage :

    {% import 'components/macros/_Card.macro.html.twig' as Card %}

    Card.projects(projects)
#}

{% macro projects(projects = []) %}
    {% import 'components/macros/_Badge.macro.html.twig' as Badge %}
    {% import 'components/macros/_Button.macro.html.twig' as Button %}
    {% import 'components/macros/_Icon.macro.html.twig' as Icon %}
    {% import 'components/macros/_User.macro.html.twig' as User %}

    <div class="cards cards--projects">

        {% for project in projects %}
            <div class="card card--project">

                <div class="project__image">
                    {% if project.cover %}
                        <img src="{{ project.cover }}" alt="{{ project.name }}">
                    {% else %}
                        {{ Icon.lucide('image', {
                            size: 'lg',
                            color: 'muted'
                        }) }}
                    {% endif %}
                </div>

                <div class="project__inner">

                    <header class="project__header">

                        <div class="project__title">
                            {{ project.name }}
                        </div>

                        <div class="project__stats">
                            {{ Icon.lucide('heart', {
                                size: 'xs',
                                color: 'danger'
                            }) }}
                            {{ project.likes|length|format_number(1) }}
                        </div>

                    </header>

                    <p class="project__description">
                        {{ project.description }}
                    </p>

                    {% set technologies = project.technologies|slice(0, 3) %}
                    {% set remainingTechnologies = project.technologies|length - technologies|length %}

                    <div class="project__technologies">

                        {% for technology in technologies %}
                            {{ Badge.render(technology.name, {
                                variant: 'secondary',
                                size: 'sm'
                            }) }}
                        {% endfor %}

                        {% if remainingTechnologies > 0 %}
                            {{ Badge.render('+' ~ remainingTechnologies, {
                                variant: 'secondary',
                                size: 'sm'
                            }) }}
                        {% endif %}

                    </div>

                    <footer class="project__footer">

                        {{ User.render({
                            avatar: project.user.avatar ?? null,
                            name: project.user.firstname,
                            username: project.user.username,
                            certified: project.user.isCertified ? true : false
                        }) }}

                        <div class="project__actions">

                            {{ Button.render('Show', {
                                size: 'sm',
                                variant: 'primary'
                            }) }}

                        </div>

                    </footer>

                </div>

            </div>

        {% endfor %}

    </div>

{% endmacro %}